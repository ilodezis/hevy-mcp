# ── Hevy API ──────────────────────────────────────────────────────────────────
# Personal API key (Hevy PRO only): https://hevy.com/settings?developer
HEVY_API_KEY=
# Base URL — leave default unless Hevy changes it.
HEVY_BASE_URL=https://api.hevyapp.com

# ── Consent-page gate (single user) ──────────────────────────────────────────
# The password you type once on the browser consent page when connecting Claude.
HEVY_MCP_PASSWORD=change_me_login_password

# ── Token signing ─────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this instantly revokes every issued MCP token (Claude must reconnect).
HEVY_MCP_SESSION_SECRET=change_me_session_secret

# ── OAuth client (Claude.ai) ──────────────────────────────────────────────────
HEVY_MCP_CLIENT_ID=hevy-claude-connector
# Generate a strong random string (same command as above).
HEVY_MCP_CLIENT_SECRET=change_me_client_secret
# Default is Claude.ai's callback; only change if connecting a different client.
HEVY_MCP_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# ── Cookies ───────────────────────────────────────────────────────────────────
# Keep true in production (HTTPS). Set false ONLY for local http://127.0.0.1 testing.
HEVY_MCP_COOKIE_SECURE=true
HEVY_MCP_COOKIE_SAMESITE=lax
