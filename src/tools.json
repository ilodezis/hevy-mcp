 {
  "_meta": {
   "fastmcp": {
    "tags": []
   }
  },
  "description": "Every set performed for ONE exercise across all workouts — the right tool\nfor progression, personal records and plateaus.\n\nPrefer this over paging ``list_workouts``: that caps at 10 workouts per call,\nso answering \"how has my bench moved this year\" through it costs dozens of\nrequests. Here it is one.\n\n``exercise_template_id`` comes from ``search_exercise_templates``.\n``start_date`` / ``end_date`` are optional ISO-8601 timestamps (e.g.\n'2026-01-01T00:00:00Z'); pass at least ``start_date`` for a long-running\nexercise, since the response is unpaginated and returns one entry per set.\nEach entry carries the workout it came from (id, title, start/end time) plus\nthe set itself (weight_kg, reps, distance_meters, duration_seconds, rpe,\nset_type), so sets can be grouped into sessions by ``workout_id``.",
  "inputSchema": {
   "properties": {
    "exercise_template_id": {
     "type": "string"
    },
    "start_date": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "end_date": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "exercise_template_id"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "name": "get_exercise_history",
  "outputSchema": {
   "type": "object",
   "additionalProperties": true
  },
  "title": "Get Exercise History"
 },
 {
  "_meta": {
   "fastmcp": {
    "tags": []
   }
  },
  "description": "Create a new routine (a reusable training plan / workout template).\n\n``exercises`` is an ordered list; each needs an ``exercise_template_id`` (from\n``search_exercise_templates``) and its ``sets``. For routines, set targets are\nthe planned weight/reps. Returns the created routine (with its new id).",
  "inputSchema": {
   "properties": {
    "title": {
     "type": "string"
    },
    "exercises": {
     "items": {
      "description": "One exercise slot. ``exercise_template_id`` comes from\n``search_exercise_templates``. Group exercises into a superset by giving them\nthe same integer ``superset_id`` (null = not in a superset).",
      "properties": {
       "exercise_template_id": {
        "type": "string"
       },
       "sets": {
        "items": {
         "description": "One set. Provide the fields relevant to the exercise type: weight_kg+reps\nfor lifts, duration_seconds for planks/cardio, distance_meters for runs.",
         "properties": {
          "type": {
           "default": "normal",
           "description": "warmup | normal | failure | dropset",
           "enum": [
            "warmup",
            "normal",
            "failure",
            "dropset"
           ],
           "type": "string"
          },
          "weight_kg": {
           "anyOf": [
            {
             "type": "number"
            },
            {
             "type": "null"
            }
           ],
           "default": null,
           "description": "Weight in kilograms"
          },
          "reps": {
           "anyOf": [
            {
             "type": "integer"
            },
            {
             "type": "null"
            }
           ],
           "default": null
          },
          "distance_meters": {
           "anyOf": [
            {
             "type": "number"
            },
            {
             "type": "null"
            }
           ],
           "default": null
          },
          "duration_seconds": {
           "anyOf": [
            {
             "type": "integer"
            },
            {
             "type": "null"
            }
           ],
           "default": null
          },
          "rpe": {
           "anyOf": [
            {
             "type": "number"
            },
            {
             "type": "null"
            }
           ],
           "default": null,
           "description": "Rate of perceived exertion 6–10 (workouts only)"
          },
          "custom_metric": {
           "anyOf": [
            {
             "type": "number"
            },
            {
             "type": "null"
            }
           ],
           "default": null
          }
         },
         "type": "object"
        },
        "type": "array"
       },
       "superset_id": {
        "anyOf": [
         {
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "default": null
       },
       "rest_seconds": {
        "anyOf": [
         {
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "default": null,
        "description": "Rest after this exercise (routines)"
       },
       "notes": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null
       }
      },
      "required": [
       "exercise_template_id",
       "sets"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "notes": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "folder_id": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    }
   },
   "required": [
    "title",
    "exercises"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "name": "create_routine",
  "outputSchema": {
   "type": "object",
   "additionalProperties": true
  },
  "title": "Create Routine"
 },
