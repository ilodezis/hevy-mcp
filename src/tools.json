 {
  "_meta": {
   "fastmcp": {
    "tags": []
   }
  },
  "description": "Find exercise templates by English or Russian title substring (case-insensitive, e.g. 'bench press' or 'жим лёжа', 'chest press' or 'жим от груди').\n\nReturns a list of {id, title, title_ru, type, primary_muscle_group, equipment, is_custom}.\nUse the ``id`` as ``exercise_template_id`` when building routines/workouts.\nScans up to ~1000 templates (default library + your custom ones).",
  "inputSchema": {
   "properties": {
    "query": {
     "type": "string"
    },
    "limit": {
     "default": 20,
     "type": "integer"
    }
   },
   "required": [
    "query"
   ],
   "type": "object",
   "additionalProperties": false
  },
  "name": "search_exercise_templates",
  "outputSchema": {
   "properties": {
    "result": {
     "items": {
      "additionalProperties": true,
      "type": "object"
     },
     "type": "array"
    }
   },
   "required": [
    "result"
   ],
   "type": "object",
   "x-fastmcp-wrap-result": true
  },
  "title": "Search Exercise Templates"
 },
